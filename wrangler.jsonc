{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m1stykmedia-site-upgrade",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "mistykmedia-subscribers",
      "database_id": "82738850-1ca1-4a64-844a-d983793a446b",
      "migrations_dir": "migrations"
    }
  ]
}
