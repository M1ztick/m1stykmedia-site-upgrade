---
import Root from './Root.astro';

interface Props {
  title: string;
  description?: string;
  section?: 'dispatch' | 'journey';
  slug: string;
}

const { title, description, section = 'dispatch', slug } = Astro.props;
---

<Root title={title} description={description} section={section}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <!-- Article header -->
    <header class="mb-12">
      <slot name="meta" />
    </header>

    <!-- Article content -->
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Interaction zone -->
    <div class="mt-16 pt-12 border-t border-void-50/10">
      
      <!-- Like button -->
      <div class="mb-12">
        <h3 class="text-sm font-mono uppercase tracking-widest text-mist/40 mb-4">Archive Signal</h3>
        <button 
          id="like-btn"
          data-slug={slug}
          class="group flex items-center gap-3 px-6 py-3 rounded-lg border border-void-50/20 bg-void-50/5 hover:border-coral/30 hover:bg-coral/5 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mist/50 group-hover:text-coral transition-colors">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="text-mist/70 group-hover:text-coral transition-colors">
            <span id="like-count">...</span> readers resonated
          </span>
        </button>
        <p class="mt-2 text-xs text-mist/30">Anonymous. No tracking. Just a number.</p>
      </div>

      <!-- Subscribe form -->
      <div class="mb-12 p-6 rounded-lg border border-void-50/10 bg-void-50/5">
        <h3 class="font-display text-lg mb-2">Stay in the Loop</h3>
        <p class="text-sm text-mist/50 mb-4">New Dispatches delivered when they surface. No schedule, no spam, no surveillance.</p>
        <form id="subscribe-form" class="flex flex-col sm:flex-row gap-3">
          <input 
            type="email" 
            name="email"
            placeholder="your@email.com" 
            required
            class="flex-1 w-full px-4 py-3 sm:py-2 rounded-md bg-void border border-void-50/20 text-mist placeholder:text-mist/30 focus:outline-none focus:border-coral/50"
          />
          <button 
            type="submit"
            class="w-full sm:w-auto px-6 py-3 sm:py-2 rounded-md bg-coral/10 text-coral border border-coral/20 hover:bg-coral/20 transition-colors text-sm font-medium shrink-0"
          >
            Subscribe
          </button>
        </form>
        <p id="subscribe-status" class="mt-3 text-sm hidden"></p>
      </div>

      <!-- Comments -->
      <div class="mb-12">
        <h3 class="text-sm font-mono uppercase tracking-widest text-mist/40 mb-4">Continue the Thread</h3>
        <p class="text-sm text-mist/50 mb-4">Log in with GitHub to respond. No data collected by Mistyk Media.</p>
        <div class="giscus-wrapper rounded-lg border border-void-50/10 p-4">
          <script src="https://giscus.app/client.js"
            data-repo="M1ztick/m1stykmedia-site-upgrade"
            data-repo-id="R_kgDOSqxSNg"
            data-category="General"
            data-category-id="DIC_kwDOSqxSNs4C_Idm"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="1"
            data-input-position="top"
            data-theme="dark_high_contrast"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
          </script>
        </div>
      </div>

    </div>
  </article>

  <script>
    // Like button logic
    (async function() {
      const btn = document.getElementById('like-btn');
      const count = document.getElementById('like-count');
      const slug = btn?.dataset.slug;
      
      if (!slug) return;

      // Check if already liked (session only, no cookies)
      const likedKey = 'liked_' + slug;
      const hasLiked = sessionStorage.getItem(likedKey);

      try {
        // Fetch current count from Cloudflare Worker
        const res = await fetch('https://likes.mistykmedia.workers.dev/?slug=' + slug);
        const data = await res.json();
        count.textContent = data.count || 0;
        
        if (hasLiked) {
          btn.classList.add('opacity-50', 'cursor-default');
          btn.classList.remove('hover:border-coral/30', 'hover:bg-coral/5');
        }
      } catch (e) {
        count.textContent = '?';
      }

      btn?.addEventListener('click', async () => {
        if (sessionStorage.getItem(likedKey)) return;
        
        try {
          const res = await fetch('https://likes.mistykmedia.workers.dev/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug })
          });
          const data = await res.json();
          count.textContent = data.count;
          sessionStorage.setItem(likedKey, 'true');
          btn.classList.add('opacity-50', 'cursor-default');
          btn.classList.remove('hover:border-coral/30', 'hover:bg-coral/5');
        } catch (e) {
          console.error('Like failed', e);
        }
      });
    })();

    // Subscribe form logic
    (function() {
      const form = document.getElementById('subscribe-form');
      const status = document.getElementById('subscribe-status');
      
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = form.email.value;
        
        try {
          const res = await fetch('https://subscribe.mistykmedia.workers.dev/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });
          
          if (res.ok) {
            status.textContent = 'Subscribed. Welcome to the Dispatch.';
            status.className = 'mt-3 text-sm text-teal';
            form.reset();
          } else {
            throw new Error('Failed');
          }
        } catch (e) {
          status.textContent = 'Something went wrong. Try again.';
          status.className = 'mt-3 text-sm text-dispatch';
        }
        status.classList.remove('hidden');
      });
    })();
  </script>
</Root>
