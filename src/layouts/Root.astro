---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: 'dispatch' | 'frequency' | 'workbench' | 'current';
}

const { title, description = 'Digital legacy of a polymath truth-seeker', section } = Astro.props;

const sectionColors = {
  dispatch: 'border-dispatch',
  frequency: 'border-frequency',
  workbench: 'border-workbench',
  current: 'border-current',
};

const accentClass = section ? sectionColors[section] : 'border-coral';

// Fetch recent items for footer
const [dispatches, frequencies, currents] = await Promise.all([
  getCollection('dispatch'),
  getCollection('frequency'),
  getCollection('current'),
]);

const latestDispatch = dispatches
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 2);
const latestFrequency = frequencies
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 2);
const latestCurrent = currents
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 2);
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <title>{title} • Mistyk Media</title>
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.classList.add(theme);
  </script>
</head>
<body class="min-h-screen flex flex-col bg-void text-mist">
  <!-- Animated top accent bar -->
  <div class="h-1 w-full bg-gradient-to-r from-coral to-teal relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer"></div>
  </div>

  <!-- Navigation -->
  <nav class="w-full border-b border-void-50/10 sticky top-0 z-40 bg-void/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-coral to-teal flex items-center justify-center font-bold text-white text-lg shadow-lg group-hover:shadow-coral/30 transition-shadow">
          M
        </div>
        <span class="font-display font-semibold text-lg tracking-tight text-mist hidden sm:block">
          MISTYK<span class="text-mist/60">MEDIA</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/dispatch" class="px-3 py-1.5 rounded-md text-sm text-mist/70 hover:text-dispatch hover:bg-dispatch/10 transition-all">Dispatch</a>
        <a href="/frequency" class="px-3 py-1.5 rounded-md text-sm text-mist/70 hover:text-frequency hover:bg-frequency/10 transition-all">Frequency</a>
        <a href="/workbench" class="px-3 py-1.5 rounded-md text-sm text-mist/70 hover:text-workbench hover:bg-workbench/10 transition-all">Workbench</a>
        <a href="/current" class="px-3 py-1.5 rounded-md text-sm text-mist/70 hover:text-current hover:bg-current/10 transition-all">Current</a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-md text-mist/70 hover:text-mist hover:bg-void-50/10 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile menu drawer -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-void-50/10 bg-void/95 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-1">
        <a href="/dispatch" class="px-3 py-2 rounded-md text-sm text-mist/70 hover:text-dispatch hover:bg-dispatch/10 transition-all">Dispatch</a>
        <a href="/frequency" class="px-3 py-2 rounded-md text-sm text-mist/70 hover:text-frequency hover:bg-frequency/10 transition-all">Frequency</a>
        <a href="/workbench" class="px-3 py-2 rounded-md text-sm text-mist/70 hover:text-workbench hover:bg-workbench/10 transition-all">Workbench</a>
        <a href="/current" class="px-3 py-2 rounded-md text-sm text-mist/70 hover:text-current hover:bg-current/10 transition-all">Current</a>
        <a href="/about" class="px-3 py-2 rounded-md text-sm text-mist/70 hover:text-coral hover:bg-coral/10 transition-all">About</a>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main class="flex-1 relative">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-void-50/10 mt-16 bg-void-50/5">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-coral animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-mist/40">Live Archive</span>
      </div>

      <div class="grid md:grid-cols-4 gap-8 text-sm">
        <div class="space-y-3">
          <h4 class="font-display text-mist/80 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-dispatch"></span>
            Dispatch
          </h4>
          <ul class="space-y-2 text-mist/50">
            {latestDispatch.map(e => (
              <li>
                <a href={`/dispatch/${e.id}`} class="hover:text-dispatch transition-colors line-clamp-1">
                  {e.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <h4 class="font-display text-mist/80 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-frequency"></span>
            Frequency
          </h4>
          <ul class="space-y-2 text-mist/50">
            {latestFrequency.map(e => (
              <li>
                <a href={`/frequency/${e.id}`} class="hover:text-frequency transition-colors line-clamp-1">
                  {e.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <h4 class="font-display text-mist/80 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            Current
          </h4>
          <ul class="space-y-2 text-mist/50">
            {latestCurrent.map(e => (
              <li>
                <a href={`/current/${e.id}`} class="hover:text-current transition-colors line-clamp-1">
                  {e.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <h4 class="font-display text-mist/80">Connect</h4>
          <ul class="space-y-2 text-mist/50">
            <li><a href="/about" class="hover:text-coral transition-colors">About</a></li>
            <li><a href="https://github.com/M1ztick" target="_blank" rel="noopener noreferrer" class="hover:text-coral transition-colors">GitHub</a></li>
            <li><a href="/workbench" class="hover:text-coral transition-colors">Workbench</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-void-50/10">
      <div class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between text-xs text-mist/30">
        <p>© {new Date().getFullYear()} Mistyk Media</p>
        <p class="hidden sm:block">Living archive in motion</p>
<script src="https://insertabot.io/widget.js" data-api-key="ib_sk_187a0c3050021de030aa1796e0172bbdcb6c41c24cf98444"></script>
      </div>
    </div>
  </footer>

  <style>
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    .animate-shimmer {
      animation: shimmer 3s infinite;
    }
  </style>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    btn?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden', isOpen);
      iconMenu?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  </script>
</body>
</html>
