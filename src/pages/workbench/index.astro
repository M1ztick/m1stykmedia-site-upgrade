---
import Root from '../../layouts/Root.astro';

const projects = [
  {
    title: 'Insertabot',
    subtitle: 'AI-powered chatbot widget SaaS',
    slug: 'insertabot',
    status: 'active',
    tech: ['TypeScript', 'Cloudflare Workers', 'D1', 'KV', 'Vectorize', 'Workers AI', 'Stripe'],
    description: 'Embeddable AI chatbot widget for websites with RAG, web search, multi-tenant auth, 2FA, and Stripe billing.',
    repo: 'https://github.com/M1ztick/insertabot-v1.0',
    demo: 'https://insertabot.io',
    demoLabel: 'Live Demo',
    accent: 'text-workbench hover:text-coral',
    borderHover: 'hover:border-workbench',
    icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  },
  {
    title: 'SAIGE',
    subtitle: 'Buddhist AI Ethics Framework',
    slug: 'saige',
    status: 'active',
    tech: ['TypeScript', 'Python', 'PyTorch', 'HuggingFace', 'Cloudflare Workers', 'Ollama'],
    description: 'AI alignment through experiential learning. Teaches ethical reasoning via 5 Buddhist principles on a continuous improvement loop.',
    repo: 'https://github.com/M1ztick/SAIGE',
    demo: 'https://buddhist-ai-worker.mistykmedia.workers.dev',
    demoLabel: 'Scoring Endpoint',
    accent: 'text-current hover:text-teal',
    borderHover: 'hover:border-current',
    icon: 'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm0-14a6 6 0 1 0 6 6 6 6 0 0 0-6-6z',
  },
];
---

<Root
  title="The Workbench"
  description="Developer projects, tools forged in code, and digital experiments."
  section="workbench"
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Section Header -->
    <header class="mb-16">
      <p class="text-xs font-mono text-workbench/60 mb-2">SECTION_03</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-4">
        The Workbench
      </h1>
      <p class="text-lg text-mist/60 max-w-2xl">
        Tools and systems built with intention. Production-grade infrastructure, AI experiments, and the code that powers the mission.
      </p>
    </header>

    <!-- Projects Grid -->
    <div class="space-y-8">
      {projects.map((project) => (
        <a
          href={`/workbench/${project.slug}`}
          class={`group block crossroads-card p-8 ${project.borderHover}`}
        >
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`${project.accent} transition-colors`}
              >
                <path d={project.icon} />
              </svg>
              <div>
                <h2 class={`font-display text-2xl font-semibold text-mist ${project.accent} transition-colors`}>
                  {project.title}
                </h2>
                <p class="text-sm text-mist/40">{project.subtitle}</p>
              </div>
            </div>
            <span class={`text-xs font-mono px-2 py-1 rounded ${project.status === 'active' ? 'bg-teal/10 text-teal' : 'bg-mist/10 text-mist/40'}`}>
              {project.status.toUpperCase()}
            </span>
          </div>

          <p class="text-mist/50 leading-relaxed mb-5">
            {project.description}
          </p>

          <!-- Tech stack -->
          <div class="flex flex-wrap gap-2 mb-6">
            {project.tech.map((t) => (
              <span class="text-xs px-2 py-1 bg-void-50/30 text-mist/40 rounded border border-void-50/10">
                {t}
              </span>
            ))}
          </div>

          <!-- Links -->
          <div class="flex items-center gap-4 text-sm">
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              onclick="event.stopPropagation()"
              class="flex items-center gap-1 text-mist/40 hover:text-workbench transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              GitHub
            </a>
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                class="flex items-center gap-1 text-mist/40 hover:text-workbench transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                {project.demoLabel}
              </a>
            )}
            <span class="ml-auto flex items-center text-mist/40 group-hover:text-workbench transition-colors">
              Details
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-1 transform group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Philosophy note -->
    <div class="mt-16 p-8 border border-workbench/20 bg-workbench/5 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-radial from-workbench/5 to-transparent pointer-events-none"></div>
      <p class="text-mist/60 italic relative z-10">
        "Code is not merely written — it is forged. Every system carries the intention of its maker."
      </p>
    </div>
  </div>
</Root>
