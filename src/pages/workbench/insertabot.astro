---
import Root from '../../layouts/Root.astro';

const project = {
  title: 'Insertabot',
  subtitle: 'AI-powered chatbot widget SaaS',
  status: 'active',
  description: 'A fully live SaaS platform that puts an AI chatbot on any website in minutes — embeddable widget, multi-tenant backend, Stripe billing, and a published WordPress plugin.',
  tech: ['TypeScript', 'Cloudflare Workers', 'D1', 'KV', 'Vectorize', 'Workers AI', 'Stripe', 'Tavily'],
  repo: 'https://github.com/M1ztick/insertabot-v1.0',
  demo: 'https://insertabot.io',
  wordpress: 'https://wordpress.org/plugins/insertabot-ai-chatbot-solution',
  startedDate: '2024-01-15',
  lastUpdated: '2025-06-01',
};

const features = [
  { label: 'RAG knowledge base', detail: 'Per-tenant vector search via Cloudflare Vectorize' },
  { label: 'Live web search', detail: 'Optional Tavily integration for real-time answers' },
  { label: 'Multi-tenant auth', detail: '2FA, isolated tenant data, role management' },
  { label: 'Stripe billing', detail: 'Usage-based metering, subscription management' },
  { label: 'Real-time analytics', detail: 'Per-tenant dashboard with conversation insights' },
  { label: 'WordPress plugin', detail: 'Published on the official WordPress plugin directory' },
];
---

<Root title="Insertabot" description={project.description} section="workbench">
  <div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Breadcrumb -->
    <nav class="mb-10 text-xs font-mono text-mist/30">
      <a href="/workbench" class="hover:text-workbench transition-colors">WORKBENCH</a>
      <span class="mx-2">/</span>
      <span class="text-mist/60">INSERTABOT</span>
    </nav>

    <!-- Header -->
    <header class="mb-12 border-l-4 border-workbench pl-6">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-2">{project.title}</h1>
          <p class="text-mist/50 text-lg">{project.subtitle}</p>
        </div>
        <span class="shrink-0 text-xs font-mono px-2 py-1 rounded bg-teal/10 text-teal mt-2">
          {project.status.toUpperCase()}
        </span>
      </div>
      <p class="text-mist/60 leading-relaxed max-w-2xl">{project.description}</p>
    </header>

    <!-- Links -->
    <div class="flex flex-wrap gap-4 mb-12">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 border border-workbench/30 text-mist/70 hover:text-workbench hover:border-workbench transition-all text-sm rounded"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        GitHub
      </a>
      <a
        href={project.demo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 border border-teal/30 text-mist/70 hover:text-teal hover:border-teal transition-all text-sm rounded"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        insertabot.io
      </a>
      <a
        href={project.wordpress}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 border border-mist/10 text-mist/70 hover:text-mist hover:border-mist/30 transition-all text-sm rounded"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        WordPress Plugin
      </a>
    </div>

    <!-- About -->
    <section class="mb-12 space-y-4">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40">About</h2>
      <p class="text-mist/60 leading-relaxed">
        Insertabot is a live, production SaaS that lets any website owner embed an AI chatbot in minutes. The entire backend runs on Cloudflare's edge — Workers, D1, KV, Vectorize, and Workers AI — with no servers to manage and global distribution built in.
      </p>
      <p class="text-mist/60 leading-relaxed">
        Each tenant gets their own isolated knowledge base, a dashboard to manage conversations and analytics, and a simple embed snippet. For WordPress users, it's available as a published plugin on the official directory — install, connect, done.
      </p>
    </section>

    <!-- Features -->
    <section class="mb-12">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40 mb-4">Features</h2>
      <div class="divide-y divide-void-50/10 border border-void-50/10 rounded overflow-hidden">
        {features.map((f) => (
          <div class="flex items-center gap-4 px-4 py-3 bg-void-50/5">
            <span class="text-mist/80 font-medium w-48 shrink-0 text-sm">{f.label}</span>
            <span class="text-mist/40 text-sm">{f.detail}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="mb-12">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40 mb-4">Tech Stack</h2>
      <div class="flex flex-wrap gap-2">
        {project.tech.map((t) => (
          <span class="text-sm px-3 py-1.5 bg-void-50/30 text-mist/60 rounded border border-void-50/10">
            {t}
          </span>
        ))}
      </div>
    </section>

    <!-- Metadata -->
    <div class="pt-8 border-t border-void-50/10 flex flex-wrap gap-8 text-xs font-mono text-mist/30">
      <span>STARTED {project.startedDate}</span>
      <span>UPDATED {project.lastUpdated}</span>
    </div>

  </div>
</Root>
