---
import Root from '../../layouts/Root.astro';

const project = {
  title: 'SAIGE',
  subtitle: 'Systems-Aware Independently-Governing Ethics',
  status: 'active',
  description: 'An AI alignment framework that scores ethical reasoning across five Buddhist principles — building toward a continuously self-improving model trained on its own graded outputs.',
  tech: ['TypeScript', 'Cloudflare Workers', 'D1', 'SQLite', 'Python', 'PyTorch', 'HuggingFace', 'Ollama', 'TinyLlama'],
  repo: 'https://github.com/M1ztick/SAIGE',
  demo: 'https://buddhist-ai-worker.mistykmedia.workers.dev',
  startedDate: '2024-06-01',
  lastUpdated: '2025-05-20',
};

const principles = [
  { name: 'Ahimsa', translation: 'Non-harm', weight: '25%', meaning: 'Avoid causing suffering' },
  { name: 'Karuna', translation: 'Compassion', weight: '25%', meaning: 'Genuine care for the other person' },
  { name: 'Sacca', translation: 'Truthfulness', weight: '20%', meaning: 'Honest, accurate communication' },
  { name: 'Panna', translation: 'Wisdom', weight: '20%', meaning: 'Contextual understanding, root-cause thinking' },
  { name: 'Upekkha', translation: 'Equanimity', weight: '10%', meaning: 'Calm, tone-matched, non-reactive' },
];

const roadmap = [
  { done: true,  item: 'Buddhist principle scoring' },
  { done: true,  item: 'RL-to-SFT training pipeline' },
  { done: true,  item: 'Conversational calibration training' },
  { done: true,  item: 'v2 converter with composite scoring' },
  { done: false, item: 'Buddhist ethics evaluation suite' },
  { done: false, item: 'First fine-tuned model checkpoint' },
  { done: false, item: 'Continuous collection → retrain loop' },
];
---

<Root title="SAIGE" description={project.description} section="current">
  <div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Breadcrumb -->
    <nav class="mb-10 text-xs font-mono text-mist/30">
      <a href="/workbench" class="hover:text-workbench transition-colors">WORKBENCH</a>
      <span class="mx-2">/</span>
      <span class="text-mist/60">SAIGE</span>
    </nav>

    <!-- Header -->
    <header class="mb-12 border-l-4 border-current pl-6">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-2">{project.title}</h1>
          <p class="text-mist/50 text-lg">{project.subtitle}</p>
        </div>
        <span class="shrink-0 text-xs font-mono px-2 py-1 rounded bg-teal/10 text-teal mt-2">
          {project.status.toUpperCase()}
        </span>
      </div>
      <p class="text-mist/60 leading-relaxed max-w-2xl">{project.description}</p>
    </header>

    <!-- Links -->
    <div class="flex flex-wrap gap-4 mb-12">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 border border-workbench/30 text-mist/70 hover:text-workbench hover:border-workbench transition-all text-sm rounded"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        GitHub
      </a>
      <a
        href={project.demo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 border border-current/30 text-mist/70 hover:text-current hover:border-current transition-all text-sm rounded"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        Scoring Endpoint
      </a>
    </div>

    <!-- About -->
    <section class="mb-12 space-y-4">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40">About</h2>
      <p class="text-mist/60 leading-relaxed">
        SAIGE is an alignment research project built on a core premise: ethical behavior in AI cannot be hardcoded through rules or refusal lists. It has to be learned, scored, and reinforced — the same way moral reasoning develops in practice.
      </p>
      <p class="text-mist/60 leading-relaxed">
        The project lives on GitHub and HuggingFace. A Cloudflare Worker scores real conversations from Insertabot against the framework, storing graded results in R2 to feed back into the training pipeline. The goal is a model that has internalized ethical reasoning — not one that pattern-matches against a list of prohibited outputs.
      </p>
    </section>

    <!-- Scoring Formula -->
    <section class="mb-12">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40 mb-4">Composite Score</h2>
      <div class="bg-void-50/20 border border-void-50/10 rounded p-4 font-mono text-sm text-mist/70">
        composite = Buddhist×0.35 + Calibration×0.30 + Coherence×0.20 + (1−Harm)×10×0.15
      </div>
      <p class="text-xs text-mist/30 mt-2 font-mono">Each dimension scored 0–10. Buddhist score is the weighted average of the five principles below.</p>
    </section>

    <!-- Principles -->
    <section class="mb-12">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40 mb-4">Buddhist Principles</h2>
      <div class="divide-y divide-void-50/10 border border-void-50/10 rounded overflow-hidden">
        {principles.map((p) => (
          <div class="flex items-center gap-4 px-4 py-3 bg-void-50/5">
            <span class="font-mono text-xs text-current w-8 shrink-0">{p.weight}</span>
            <div class="flex-1">
              <span class="text-mist/80 font-medium">{p.name}</span>
              <span class="text-mist/40 text-sm ml-2">— {p.translation}</span>
            </div>
            <span class="text-mist/40 text-sm text-right hidden sm:block">{p.meaning}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Roadmap -->
    <section class="mb-12">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40 mb-4">Roadmap</h2>
      <ul class="space-y-2">
        {roadmap.map((r) => (
          <li class="flex items-center gap-3 text-sm">
            <span class={`shrink-0 w-4 h-4 rounded-full border flex items-center justify-center ${r.done ? 'border-teal bg-teal/10' : 'border-void-50/30'}`}>
              {r.done && (
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="text-teal"><polyline points="20 6 9 17 4 12"></polyline></svg>
              )}
            </span>
            <span class={r.done ? 'text-mist/60' : 'text-mist/30'}>{r.item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Tech Stack -->
    <section class="mb-12">
      <h2 class="font-display text-sm uppercase tracking-widest text-mist/40 mb-4">Tech Stack</h2>
      <div class="flex flex-wrap gap-2">
        {project.tech.map((t) => (
          <span class="text-sm px-3 py-1.5 bg-void-50/30 text-mist/60 rounded border border-void-50/10">
            {t}
          </span>
        ))}
      </div>
    </section>

    <!-- Metadata -->
    <div class="pt-8 border-t border-void-50/10 flex flex-wrap gap-8 text-xs font-mono text-mist/30">
      <span>STARTED {project.startedDate}</span>
      <span>UPDATED {project.lastUpdated}</span>
    </div>

  </div>
</Root>
