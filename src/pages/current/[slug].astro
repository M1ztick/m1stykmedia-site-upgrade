---
import { getCollection, render } from 'astro:content';
import Root from '../../layouts/Root.astro';

export const prerender = true;

export async function getStaticPaths() {
  const currentEntries = await getCollection('current');
  return currentEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Root title={entry.data.title} description={entry.data.description} section="current">
  <article class="max-w-3xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-12 border-b border-void-50/10 pb-8">
      <div class="flex items-center gap-4 mb-4">
        {entry.data.category && (
          <span class="text-xs font-mono text-current uppercase tracking-wider">{entry.data.category}</span>
        )}
        <span class="text-mist/30">•</span>
        <time class="text-xs font-mono text-mist/40">
          {new Date(entry.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-mist mb-4">{entry.data.title}</h1>
      <p class="text-lg text-mist/60">{entry.data.description}</p>
    </header>

    <!-- Tags -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {entry.data.tags.map((tag) => (
          <span class="text-xs px-2 py-1 bg-void-50/30 text-mist/40 rounded">{tag}</span>
        ))}
      </div>
    )}

    <!-- Content -->
    <div class="prose prose-invert prose-mist max-w-none">
      <Content />
    </div>

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-void-50/10">
      <a href="/current" class="text-mist/40 hover:text-current transition-colors flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to The Current
      </a>
    </footer>
  </article>
</Root>
