---
import { getCollection } from 'astro:content';
import Root from '../../layouts/Root.astro';

const allCurrent = await getCollection('current');
const currents = allCurrent.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

function getStreamTags(tags: string[] | undefined): string[] {
  if (!tags) return [];
  const spiritualTerms = ['esotericism', 'mysticism', 'spirituality', 'hinduism', 'spirituality-religion'];
  const techTerms = ['artificial-intelligence', 'ai', 'chat-gpt', 'chatgpt', 'claude', 'anthropic', 'deep-mind', 'gen-ai', 'technology', 'chatbot', 'chatbots', 'cloudflare'];
  return tags.filter(tag =>
    spiritualTerms.includes(tag.toLowerCase()) || techTerms.includes(tag.toLowerCase())
  );
}

function isSpiritual(entry: (typeof currents)[number]): boolean {
  const spiritualTerms = ['esotericism', 'mysticism', 'spirituality', 'hinduism', 'spirituality-religion'];
  if (entry.data.category === 'spiritual') return true;
  return entry.data.tags?.some(tag =>
    spiritualTerms.includes(tag.toLowerCase())
  ) ?? false;
}

function isTech(entry: (typeof currents)[number]): boolean {
  const techTerms = ['artificial-intelligence', 'ai', 'chat-gpt', 'chatgpt', 'claude', 'anthropic', 'deep-mind', 'gen-ai', 'technology', 'chatbot', 'chatbots', 'cloudflare'];
  if (entry.data.category === 'tech') return true;
  return entry.data.tags?.some(tag =>
    techTerms.includes(tag.toLowerCase())
  ) ?? false;
}

const illumination = currents.filter(isSpiritual);
const machination = currents.filter(isTech);
// Entries that match neither stream still appear in both columns for discoverability,
// or could be shown in a separate "Unclassified" section. For now, include in both.
const unclassified = currents.filter(c => !isSpiritual(c) && !isTech(c));
---

<Root 
  title="The Current" 
  description="AI, technology, consciousness, and the undercurrent of inquiry."
  section="current"
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Section Header -->
    <header class="mb-16">
      <p class="text-xs font-mono text-current/60 mb-2">SECTION_04</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-4">
        The Current
      </h1>
      <p class="text-lg text-mist/60 max-w-2xl">
        Maps for those who seek beyond the veil. AI systems, consciousness exploration, and the intersection of technology and the numinous.
      </p>
    </header>

    <!-- Dual streams -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Spiritual Stream -->
      <div>
        <h2 class="font-display text-lg text-mist/80 mb-6 pb-2 border-b border-void-50/10 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-current/60"></span>
          Illumination
        </h2>
        <div class="space-y-6">
          {illumination.length === 0 && unclassified.length === 0 && (
            <p class="text-sm text-mist/30 italic">No entries yet.</p>
          )}
          {illumination.map((entry) => (
            <a href={`/current/${entry.id}`} class="block group">
              <div class="flex items-baseline gap-3 mb-1">
                <span class="text-xs font-mono text-mist/40">
                  {new Date(entry.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
              <h3 class="text-mist group-hover:text-current transition-colors mb-2 font-medium">
                {entry.data.title}
              </h3>
              <p class="text-sm text-mist/40 leading-relaxed">
                {entry.data.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {getStreamTags(entry.data.tags).map((tag) => (
                  <span class="text-xs px-2 py-0.5 bg-void-50/30 text-mist/30 rounded">{tag}</span>
                ))}
              </div>
            </a>
          ))}
          {unclassified.map((entry) => (
            <a href={`/current/${entry.id}`} class="block group">
              <div class="flex items-baseline gap-3 mb-1">
                <span class="text-xs font-mono text-mist/40">
                  {new Date(entry.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
              <h3 class="text-mist group-hover:text-current transition-colors mb-2 font-medium">
                {entry.data.title}
              </h3>
              <p class="text-sm text-mist/40 leading-relaxed">
                {entry.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>

      <!-- Tech Stream -->
      <div>
        <h2 class="font-display text-lg text-mist/80 mb-6 pb-2 border-b border-void-50/10 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal/60"></span>
          Machination
        </h2>
        <div class="space-y-6">
          {machination.length === 0 && unclassified.length === 0 && (
            <p class="text-sm text-mist/30 italic">No entries yet.</p>
          )}
          {machination.map((entry) => (
            <a href={`/current/${entry.id}`} class="block group">
              <div class="flex items-baseline gap-3 mb-1">
                <span class="text-xs font-mono text-mist/40">
                  {new Date(entry.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
              <h3 class="text-mist group-hover:text-teal transition-colors mb-2 font-medium">
                {entry.data.title}
              </h3>
              <p class="text-sm text-mist/40 leading-relaxed">
                {entry.data.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {getStreamTags(entry.data.tags).map((tag) => (
                  <span class="text-xs px-2 py-0.5 bg-void-50/30 text-mist/30 rounded">{tag}</span>
                ))}
              </div>
            </a>
          ))}
          {unclassified.map((entry) => (
            <a href={`/current/${entry.id}`} class="block group">
              <div class="flex items-baseline gap-3 mb-1">
                <span class="text-xs font-mono text-mist/40">
                  {new Date(entry.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
              <h3 class="text-mist group-hover:text-teal transition-colors mb-2 font-medium">
                {entry.data.title}
              </h3>
              <p class="text-sm text-mist/40 leading-relaxed">
                {entry.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Note on synthesis -->
    <div class="mt-16 p-8 border border-current/20 bg-current/5 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-radial from-current/5 to-transparent pointer-events-none"></div>
      <p class="text-mist/60 italic relative z-10">
        "The Current recognizes no artificial boundaries between the technical and the transcendent."
      </p>
    </div>
  </div>
</Root>
