---
import { getCollection } from 'astro:content';
import Root from '../../layouts/Root.astro';

const allDispatches = await getCollection('dispatch');
const dispatches = allDispatches.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<Root 
  title="The Dispatch" 
  description="Narratives, power structures, and the search for what holds."
  section="dispatch"
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Section Header -->
    <header class="mb-16">
      <p class="text-xs font-mono text-dispatch/60 mb-2">SECTION_01</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-4">
        The Dispatch
      </h1>
      <p class="text-lg text-mist/60 max-w-2xl">
        Where power is named and narratives are dismantled. Investigations, analysis, and essays on systems, structures, and the stories we tell ourselves.
      </p>
    </header>

    <!-- Dispatch List -->
    <div class="space-y-8">
      {dispatches.map((entry, index) => (
        <>
          <article class="group">
            <a href={`/dispatch/${entry.id}`} class="block">
              <div class="flex items-baseline gap-4 mb-2">
                <span class="text-xs font-mono text-mist/40">
                  {new Date(entry.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                {entry.data.category && (
                  <span class="text-xs font-mono text-dispatch uppercase tracking-wider">{entry.data.category}</span>
                )}
              </div>
              <h2 class="font-display text-xl md:text-2xl text-mist group-hover:text-dispatch transition-colors mb-3">
                {entry.data.title}
              </h2>
              <p class="text-mist/50 leading-relaxed">
                {entry.data.description}
              </p>
              <div class="mt-4 flex items-center text-sm text-mist/40 group-hover:text-dispatch transition-colors">
                <span>Read</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          </article>

          {index < dispatches.length - 1 && (
            <hr class="border-coral/10" />
          )}
        </>
      ))}
    </div>
  </div>
</Root>