---
import Root from '../../layouts/Root.astro';

// Placeholder - will pull from content collection
const recentDispatches = [
  {
    title: "Project 2025: The Conspiracy That Isn't a Theory",
    description: "The Quiet Takeover & The Political Scarecrow...",
    date: "2025-01-15",
    category: "investigation",
    slug: "introduction-to-project-2025"
  },
  {
    title: "Billionaire Buy In: American Electoral Mythos",
    description: "The notion that anyone can become President is a compelling American myth...",
    date: "2025-01-10",
    category: "analysis",
    slug: "billionaire-buy-in"
  },
  {
    title: "The Justice Department's Selective Incompetence",
    description: "Recent failure to redact the names of Jeffrey Epstein's victims is not a routine clerical lapse...",
    date: "2024-12-28",
    category: "investigation",
    slug: "justice-department-incompetence"
  }
];
---

<Root 
  title="The Dispatch" 
  description="Narratives, power structures, and the search for what holds."
  section="dispatch"
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Section Header -->
    <header class="mb-16">
      <p class="text-xs uppercase tracking-widest text-dispatch mb-2">Section 01</p>
      <h1 class="font-display text-4xl md:text-5xl text-mistyk-900 mb-4">
        The Dispatch
      </h1>
      <p class="text-lg text-mistyk-600 max-w-2xl">
        Where power is named and narratives are dismantled. Investigations, analysis, and essays on systems, structures, and the stories we tell ourselves.
      </p>
    </header>

    <!-- Dispatch List -->
    <div class="space-y-8">
      {recentDispatches.map((dispatch, index) => (
        <article class="group">
          <a href={`/dispatch/${dispatch.slug}`} class="block">
            <div class="flex items-baseline gap-4 mb-2">
              <span class="text-xs text-mistyk-400">{dispatch.date}</span>
              <span class="text-xs uppercase tracking-wider text-dispatch">{dispatch.category}</span>
            </div>
            <h2 class="font-display text-xl md:text-2xl text-mistyk-900 group-hover:text-dispatch transition-colors mb-2">
              {dispatch.title}
            </h2>
            <p class="text-mistyk-600 leading-relaxed">
              {dispatch.description}
            </p>
            <div class="mt-4 flex items-center text-sm text-mistyk-500 group-hover:text-dispatch transition-colors">
              <span>Read more</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        </article>
        
        {index < recentDispatches.length - 1 && (
          <hr class="border-mistyk-200" />
        )}
      ))}
    </div>

    <!-- Archive Link -->
    <div class="mt-16 pt-8 border-t border-mistyk-200">
      <p class="text-sm text-mistyk-500">
        Browse the complete dispatch archive → <a href="#" class="text-dispatch hover:underline">All posts</a>
      </p>
    </div>
  </div>
</Root>