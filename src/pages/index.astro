---
import { getCollection } from 'astro:content';
import Root from '../layouts/Root.astro';

// Fetch dispatch content
const dispatches = await getCollection('dispatch');

const latestDispatches = dispatches
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

const featuredDispatch = latestDispatches[0];
const otherDispatches = latestDispatches.slice(1);
---

<Root 
  title="Dispatch" 
  description="Investigative journalism, power analysis, and documented truth from Mistyk Media."
  section="dispatch"
>

  <!-- Hero: Featured Dispatch -->
  <section class="relative min-h-[60vh] flex items-end px-6 pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-dispatch/10 via-transparent to-transparent pointer-events-none"></div>

    <div class="max-w-4xl mx-auto w-full relative z-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-dispatch animate-pulse"></span>
        <span class="text-xs font-mono text-dispatch uppercase tracking-widest">Latest Transmission</span>
      </div>

      <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-4 tracking-tight leading-tight">
        {featuredDispatch.data.title}
      </h1>
      
      <p class="text-lg text-mist/60 mb-6 max-w-2xl leading-relaxed">
        {featuredDispatch.data.description}
      </p>

      <div class="flex items-center gap-4">
        <a 
          href={`/dispatch/${featuredDispatch.id}`} 
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-dispatch text-void font-medium text-sm rounded-md hover:bg-dispatch/90 transition-colors"
        >
          Read Dispatch
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <span class="text-xs font-mono text-mist/40">
          {new Date(featuredDispatch.data.pubDate).toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })}
        </span>
      </div>
    </div>
  </section>

  <!-- Dispatch Archive Grid -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-display text-xl text-mist/80">// Archive — All Transmissions</h2>
      <span class="text-xs font-mono text-mist/40">{dispatches.length} dispatches</span>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {otherDispatches.map((dispatch) => (
        <a
          href={`/dispatch/${dispatch.id}`}
          class="group p-6 border border-void-50/10 bg-void/50 hover:border-dispatch/30 transition-all"
        >
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-mono text-dispatch uppercase tracking-wider">
              {new Date(dispatch.data.pubDate).toLocaleDateString('en-US', { 
                month: 'short',
                day: 'numeric'
              })}
            </span>
            {dispatch.data.tags?.includes('urgent') && (
              <span class="text-xs text-coral font-medium">⚡ Urgent</span>
            )}
          </div>
          
          <h3 class="font-display text-lg font-semibold text-mist mb-2 group-hover:text-dispatch transition-colors line-clamp-2">
            {dispatch.data.title}
          </h3>
          
          <p class="text-sm text-mist/50 line-clamp-3 leading-relaxed">
            {dispatch.data.description}
          </p>

          <div class="mt-4 flex items-center gap-2 text-xs text-mist/30">
            <span>{dispatch.data.readingTime || '8 min read'}</span>
            {dispatch.data.tags?.map((tag: string) => (
              <span class="px-2 py-0.5 border border-void-50/20 rounded">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- External Links: More from Mistyk -->
  <section class="border-t border-void-50/10 py-16 bg-void-50/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-2 mb-8">
        <span class="w-2 h-2 rounded-full bg-coral"></span>
        <h2 class="font-display text-lg text-mist/80">More from Mistyk</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <!-- Music -->
        <div class="p-6 border border-void-50/10 bg-void/30">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded bg-frequency/20 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-frequency">
                <path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
              </svg>
            </div>
            <h3 class="font-display text-mist/80">Original Music</h3>
          </div>
          
          <p class="text-sm text-mist/50 mb-4">Hip-hop, punk rock crossovers, and genre-bending experiments.</p>
          
          <div class="flex flex-wrap gap-2">
            <a 
              href="https://soundcloud.com/m1styk" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs border border-void-50/20 text-mist/60 hover:text-frequency hover:border-frequency/30 transition-all rounded"
            >
              SoundCloud ↗
            </a>
            <a 
              href="https://open.spotify.com/artist/m1styk" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs border border-void-50/20 text-mist/60 hover:text-frequency hover:border-frequency/30 transition-all rounded"
            >
              Spotify ↗
            </a>
            <a 
              href="https://www.bandlab.com/m1styk" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs border border-void-50/20 text-mist/60 hover:text-frequency hover:border-frequency/30 transition-all rounded"
            >
              BandLab ↗
            </a>
          </div>
        </div>

        <!-- Development -->
        <div class="p-6 border border-void-50/10 bg-void/30">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded bg-workbench/20 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-workbench">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            </div>
            <h3 class="font-display text-mist/80">Development & Open Source</h3>
          </div>
          
          <p class="text-sm text-mist/50 mb-4">AI ethics frameworks, web applications, and experimental tooling.</p>
          
          <div class="flex flex-wrap gap-2">
            <a 
              href="https://github.com/M1ztick" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs border border-void-50/20 text-mist/60 hover:text-workbench hover:border-workbench/30 transition-all rounded"
            >
              GitHub ↗
            </a>
            <a 
              href="https://github.com/M1ztick/SAIGE" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs border border-void-50/20 text-mist/60 hover:text-workbench hover:border-workbench/30 transition-all rounded"
            >
              SAIGE Project ↗
            </a>
            <a 
              href="https://insertabot.io" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs border border-void-50/20 text-mist/60 hover:text-workbench hover:border-workbench/30 transition-all rounded"
            >
              Insertabot ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Root>
