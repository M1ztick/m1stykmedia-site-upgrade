---
import { getCollection } from 'astro:content';
import Root from '../layouts/Root.astro';

// Fetch recent content from each section
const [dispatches, frequencies, currents] = await Promise.all([
  getCollection('dispatch'),
  getCollection('frequency'),
  getCollection('current'),
]);

const sections = [
  {
    id: 'dispatch',
    title: 'The Dispatch',
    subtitle: 'Narratives, power structures, and the search for what holds',
    path: '/dispatch',
    accent: 'border-dispatch',
    hover: 'hover:border-dispatch',
    icon: 'M12 19l7-7 3 3-7 7-3-3z M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z M2 2l7.586 7.586',
    recent: dispatches
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
      .slice(0, 2),
  },
  {
    id: 'frequency',
    title: 'The Frequency',
    subtitle: 'Original music, sound experiments, and sonic documentation',
    path: '/frequency',
    accent: 'border-frequency',
    hover: 'hover:border-frequency',
    icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3',
    recent: frequencies
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
      .slice(0, 2),
  },
  {
    id: 'workbench',
    title: 'The Workbench',
    subtitle: 'Developer projects, tools forged in code, and digital experiments',
    path: '/workbench',
    accent: 'border-workbench',
    hover: 'hover:border-workbench',
    icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
    recent: [],
  },
  {
    id: 'current',
    title: 'The Current',
    subtitle: 'AI, technology, consciousness, and the undercurrent of inquiry',
    path: '/current',
    accent: 'border-current',
    hover: 'hover:border-current',
    icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
    recent: currents
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
      .slice(0, 2),
  },
];

const activity = [
  ...dispatches.map(e => ({ section: 'DISPATCH', color: 'text-dispatch', hoverBorder: 'hover:border-dispatch/30', title: e.data.title, date: e.data.pubDate, href: `/dispatch/${e.id}` })),
  ...frequencies.map(e => ({ section: 'FREQUENCY', color: 'text-frequency', hoverBorder: 'hover:border-frequency/30', title: e.data.title, date: e.data.pubDate, href: `/frequency/${e.id}` })),
  ...currents.map(e => ({ section: 'CURRENT', color: 'text-current', hoverBorder: 'hover:border-current/30', title: e.data.title, date: e.data.pubDate, href: `/current/${e.id}` })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 4);
---

<Root title="The Crossroads" description="Digital legacy of a polymath truth-seeker. Dispatches, frequencies, and works in progress.">

  <!-- Hero -->
  <section class="relative min-h-[70vh] flex items-center justify-center px-6">
    <div class="absolute inset-0 bg-gradient-radial from-coral/5 via-transparent to-transparent pointer-events-none"></div>

    <div class="max-w-3xl mx-auto text-center relative z-10">
      <div class="mb-10 flex justify-center">
        <img
          src="/images/official-mistykmedia-logo.png"
          alt="Mistyk Media"
          class="w-40 h-40 object-contain drop-shadow-2xl"
          onerror="this.style.display='none'"
        />
      </div>

      <h1 class="font-display text-5xl md:text-6xl font-bold text-mist mb-4 tracking-tight">
        <span class="gradient-text">Mistyk</span> Media
      </h1>
      <p class="text-lg md:text-xl text-mist/60 mb-2 max-w-xl mx-auto">
        A living archive of inquiry across the spectrum of human becoming.
      </p>
      <p class="text-sm text-mist/40 font-mono">
        CHOOSE YOUR ENTRY POINT ↓
      </p>
    </div>
  </section>

  <!-- The Crossroads - Four paths with previews -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    <div class="grid md:grid-cols-2 gap-5">
      {sections.map((section, index) => (
        <a
          href={section.path}
          class={`group crossroads-card p-8 ${section.hover}`}
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-xs font-mono text-mist/30">0{index + 1}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-mist/30 group-hover:text-mist/60 transition-colors"
            >
              <path d={section.icon} />
            </svg>
          </div>

          <h2 class={`font-display text-2xl font-semibold mb-2 text-mist ${section.accent} pl-3`}>
            {section.title}
          </h2>

          <p class="text-mist/50 leading-relaxed">
            {section.subtitle}
          </p>

          <!-- Recent post previews -->
          {section.recent.length > 0 && (
            <div class="mt-5 pt-5 border-t border-void-50/10">
              <p class="text-xs font-mono text-mist/30 uppercase tracking-wider mb-2">Latest</p>
              <ul class="space-y-2">
                {section.recent.map((entry) => (
                  <li class="flex items-baseline gap-2">
                    <span class="text-xs text-mist/30 shrink-0">
                      {new Date(entry.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                    </span>
                    <span class="text-sm text-mist/60 line-clamp-1 group-hover:text-mist/80 transition-colors">
                      {entry.data.title}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="mt-6 flex items-center text-sm text-mist/40 group-hover:text-coral transition-colors">
            <span>Enter</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transform group-hover:translate-x-1 transition-transform">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Activity Strip -->
  <section class="border-t border-void-50/10 py-16 bg-void-50/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h3 class="font-display text-xl text-mist/80">Recent Activity</h3>
        <span class="text-xs font-mono text-mist/40 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-coral animate-pulse"></span>
          ARCHIVE_ACTIVE
        </span>
      </div>

      <div class="space-y-3">
        {activity.map((item) => (
          <a
            href={item.href}
            class={`flex items-center gap-4 p-4 border border-void-50/10 bg-void/50 ${item.hoverBorder} transition-colors group`}
          >
            <span class={`text-xs font-mono ${item.color} uppercase tracking-wider w-24 shrink-0`}>
              {item.section}
            </span>
            <span class="text-mist group-hover:text-mist/80 line-clamp-1 flex-1">{item.title}</span>
            <span class="ml-auto text-xs font-mono text-mist/30 shrink-0">
              {new Date(item.date).toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Root>
