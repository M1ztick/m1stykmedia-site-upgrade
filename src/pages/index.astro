---
import { getCollection } from 'astro:content';
import Root from '../layouts/Root.astro';

const dispatches = await getCollection('dispatch');
const journeys = await getCollection('journey');

const sortedDispatches = dispatches.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const featuredDispatch = sortedDispatches[0];
const recentDispatches = sortedDispatches.slice(1, 3);

const dateFmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Root
  title="Mistyk Media"
  description="Investigative dispatches, inner exploration, original music, and the code behind all three — from one person working in the open."
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden px-6 pt-16 pb-16 md:pt-20 md:pb-24">
    <!-- Decorative glow blobs -->
    <div class="absolute -top-24 -left-24 w-64 h-64 md:w-96 md:h-96 bg-coral/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-16 w-64 h-64 md:w-96 md:h-96 bg-teal/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 bg-circuit opacity-60 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10 grid md:grid-cols-[1.15fr_0.85fr] gap-10 md:gap-8 items-center">
      <!-- Copy column -->
      <div class="text-center md:text-left order-2 md:order-1">
        <div class="inline-flex items-center gap-2 mb-6 px-3 py-1.5 rounded-full border border-void-50/20 bg-void-50/5">
          <span class="w-1.5 h-1.5 rounded-full bg-coral animate-pulse"></span>
          <span class="text-[11px] sm:text-xs font-mono text-mist/50 uppercase tracking-widest">Live archive, updated in the open</span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-[1.1]">
          <span class="text-mist">Documented truth.</span><br />
          <span class="gradient-text">Undocumented consciousness.</span>
        </h1>

        <p class="text-base md:text-lg text-mist/60 max-w-2xl mx-auto md:mx-0 leading-relaxed mb-10 px-2 md:px-0">
          Mistyk Media is one person's ongoing investigation — into power, into presence,
          and into the code underneath both. Dispatches on systems and narrative, essays on
          consciousness beyond dogma, original music, and open-source software, all built solo.
        </p>

        <div class="flex flex-col sm:flex-row items-center md:items-start justify-center md:justify-start gap-3 sm:gap-4 px-4 sm:px-0">
          <a
            href="/dispatch"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-dispatch text-void font-semibold text-sm rounded-md hover:bg-dispatch/90 transition-colors"
          >
            Read The Dispatch
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a
            href="#paths"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 border border-void-50/20 text-mist/70 font-medium text-sm rounded-md hover:border-coral/40 hover:text-mist transition-colors"
          >
            Explore Everything
          </a>
        </div>

        <!-- Stats strip -->
        <div class="mt-14 flex items-center justify-center md:justify-start gap-5 sm:gap-10 flex-wrap text-center md:text-left">
          <div>
            <div class="font-display text-2xl md:text-3xl font-bold text-dispatch">{dispatches.length}+</div>
            <div class="text-[11px] text-mist/40 uppercase tracking-wide mt-1">Dispatches</div>
          </div>
          <div class="w-px h-8 bg-void-50/20"></div>
          <div>
            <div class="font-display text-2xl md:text-3xl font-bold text-journey">{journeys.length}</div>
            <div class="text-[11px] text-mist/40 uppercase tracking-wide mt-1">Journeys</div>
          </div>
          <div class="w-px h-8 bg-void-50/20"></div>
          <div>
            <div class="font-display text-2xl md:text-3xl font-bold text-teal">1</div>
            <div class="text-[11px] text-mist/40 uppercase tracking-wide mt-1">Rebel AI, live ↓</div>
          </div>
        </div>
      </div>

      <!-- Visual column -->
      <div class="order-1 md:order-2 flex justify-center md:justify-end">
        <div class="relative w-48 sm:w-64 md:w-full max-w-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-coral/20 to-teal/20 blur-3xl rounded-full pointer-events-none"></div>
          <img
            src="/images/hero-face-icon.png"
            alt="Mistyk Media — human consciousness rendered as circuitry, a face half-formed from code"
            class="relative w-full h-auto drop-shadow-[0_0_40px_rgba(46,196,182,0.25)]"
            width="896"
            height="1200"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THREE PATHS ============ -->
  <section id="paths" class="max-w-6xl mx-auto px-6 py-14 md:py-20 scroll-mt-20">
    <div class="text-center mb-10 md:mb-12">
      <p class="text-xs font-mono text-mist/40 uppercase tracking-widest mb-2">Three ways in</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-mist">Pick your entry point</h2>
    </div>

    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
      <!-- Dispatch -->
      <a
        href="/dispatch"
        class="group crossroads-card p-6 md:p-7 hover:border-dispatch/40 flex flex-col"
      >
        <div class="w-11 h-11 rounded-lg bg-dispatch/15 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-dispatch">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <line x1="10" y1="9" x2="8" y2="9"></line>
          </svg>
        </div>
        <h3 class="font-display text-xl text-mist mb-2 group-hover:text-dispatch transition-colors">The Dispatch</h3>
        <p class="text-sm text-mist/50 leading-relaxed mb-5 flex-1">
          Investigative writing on power, AI, geopolitics, and the systems most people
          are told not to look at too closely.
        </p>
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-dispatch">
          {dispatches.length} investigations
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </a>

      <!-- The Inner Journey -->
      <a
        href="/journey"
        class="group crossroads-card p-6 md:p-7 hover:border-journey/40 flex flex-col"
      >
        <div class="w-11 h-11 rounded-lg bg-journey/15 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-journey">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <h3 class="font-display text-xl text-mist mb-2 group-hover:text-journey transition-colors">The Inner Journey</h3>
        <p class="text-sm text-mist/50 leading-relaxed mb-5 flex-1">
          Mysticism, esotericism, and the search for consciousness beyond dogma —
          the undercurrent beneath the Dispatch.
        </p>
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-journey">
          {journeys.length} {journeys.length === 1 ? 'reflection' : 'reflections'}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </a>

      <!-- Links -->
      <a
        href="/links"
        class="group crossroads-card p-6 md:p-7 hover:border-teal/40 flex flex-col sm:col-span-2 md:col-span-1"
      >
        <div class="w-11 h-11 rounded-lg bg-teal/15 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </div>
        <h3 class="font-display text-xl text-mist mb-2 group-hover:text-teal transition-colors">Music &amp; Code</h3>
        <p class="text-sm text-mist/50 leading-relaxed mb-5 flex-1">
          Original tracks as Mistyk, plus the AI infrastructure and open-source
          projects I build on Cloudflare's edge — including the bot in the corner.
        </p>
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-teal">
          View links
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- ============ LATEST DISPATCH SPOTLIGHT ============ -->
  {featuredDispatch && (
    <section class="border-t border-void-50/10 bg-void-50/5">
      <div class="max-w-5xl mx-auto px-6 py-14 md:py-20">
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-dispatch animate-pulse"></span>
            <h2 class="font-display text-lg md:text-xl text-mist/80">Latest Transmission</h2>
          </div>
          <a href="/dispatch" class="text-xs font-mono text-mist/40 hover:text-dispatch transition-colors whitespace-nowrap">
            View all →
          </a>
        </div>

        <!-- Featured -->
        <a
          href={`/dispatch/${featuredDispatch.id}`}
          class="group block mb-6 p-6 md:p-8 crossroads-card hover:border-dispatch/30"
        >
          <div class="flex items-center gap-3 mb-3 text-xs font-mono text-mist/40">
            <span class="text-dispatch uppercase tracking-wider">{featuredDispatch.data.category || 'Dispatch'}</span>
            <span>•</span>
            <span>{dateFmt(featuredDispatch.data.pubDate)}</span>
          </div>
          <h3 class="font-display text-xl md:text-2xl font-semibold text-mist mb-3 group-hover:text-dispatch transition-colors">
            {featuredDispatch.data.title}
          </h3>
          <p class="text-sm md:text-base text-mist/50 leading-relaxed line-clamp-3">
            {featuredDispatch.data.description}
          </p>
        </a>

        <!-- Recent pair -->
        {recentDispatches.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
            {recentDispatches.map((dispatch) => (
              <a
                href={`/dispatch/${dispatch.id}`}
                class="group p-5 crossroads-card hover:border-dispatch/30"
              >
                <span class="text-xs font-mono text-mist/40 block mb-2">{dateFmt(dispatch.data.pubDate)}</span>
                <h4 class="font-display text-base text-mist mb-2 group-hover:text-dispatch transition-colors line-clamp-2">
                  {dispatch.data.title}
                </h4>
                <p class="text-xs text-mist/40 line-clamp-2 leading-relaxed">{dispatch.data.description}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ============ INSERTABOT TEASER ============ -->
  <section class="max-w-4xl mx-auto px-6 py-14 md:py-20">
    <div class="crossroads-card p-7 md:p-10 relative overflow-hidden text-center">
      <div class="absolute inset-0 bg-gradient-radial from-teal/10 to-transparent pointer-events-none"></div>
      <div class="relative z-10">
        <p class="text-xs font-mono text-teal uppercase tracking-widest mb-3">Psst — look in the corner</p>
        <h2 class="font-display text-xl sm:text-2xl md:text-3xl font-bold text-mist mb-4">
          That's a live product, not a plugin.
        </h2>
        <p class="text-sm md:text-base text-mist/60 max-w-xl mx-auto mb-6 leading-relaxed">
          The chat widget on this site is <strong class="text-mist/80">Insertabot</strong> —
          an AI chatbot-provisioning SaaS I built solo on Cloudflare's edge. Rebel-Dev
          personality included. Go ahead, ask it something.
        </p>
        <a
          href="/links"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-teal/30 text-teal font-medium text-sm rounded-md hover:bg-teal/10 transition-colors"
        >
          See what else I've built
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </section>
</Root>
