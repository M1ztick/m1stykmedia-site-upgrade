---
import Root from '../layouts/Root.astro';

const sections = [
  {
    id: 'dispatch',
    title: 'The Dispatch',
    subtitle: 'Narratives, power structures, and the search for what holds',
    path: '/dispatch',
    accent: 'border-dispatch',
    hover: 'hover:border-dispatch',
    icon: 'M12 19l7-7 3 3-7 7-3-3z M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z M2 2l7.586 7.586',
  },
  {
    id: 'archive',
    title: 'The Archive',
    subtitle: 'Original music, sound experiments, and sonic documentation',
    path: '/archive',
    accent: 'border-archive',
    hover: 'hover:border-archive',
    icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3',
  },
  {
    id: 'workbench',
    title: 'The Workbench',
    subtitle: 'Developer projects, tools forged in code, and digital experiments',
    path: '/workbench',
    accent: 'border-workbench',
    hover: 'hover:border-workbench',
    icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  },
  {
    id: 'current',
    title: 'The Current',
    subtitle: 'AI, technology, consciousness, and the undercurrent of inquiry',
    path: '/current',
    accent: 'border-current',
    hover: 'hover:border-current',
    icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  },
];
---

<Root title="The Crossroads" description="Digital legacy of a polymath truth-seeker. Dispatches, archives, and works in progress.">
  
  <!-- Hero // Space for the decision -->
  <section class="relative min-h-[70vh] flex items-center justify-center px-6">
    <div class="max-w-3xl mx-auto text-center">
      <!-- Logo space - placeholder for your boss logo -->
      <div class="mb-8 flex justify-center">
        <div class="w-24 h-24 rounded-full border-2 border-mistyk-300 flex items-center justify-center bg-white/50">
          <span class="font-display text-3xl text-mistyk-600">M</span>
        </div>
      </div>
      
      <h1 class="font-display text-4xl md:text-5xl text-mistyk-900 mb-4 tracking-tight">
        Mistyk Media
      </h1>
      <p class="text-lg text-mistyk-600 mb-2 max-w-lg mx-auto">
        A living archive of inquiry across the spectrum of human becoming.
      </p>
      <p class="text-sm text-mistyk-500">
        Choose your entry point below ↓
      </p>
    </div>
  </section>

  <!-- The Crossroads // Four paths -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    <div class="grid md:grid-cols-2 gap-6">
      {sections.map((section, index) => (
        <a 
          href={section.path}
          class={`group crossroads-card p-8 ${section.hover}`}
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-xs uppercase tracking-widest text-mistyk-500">0{index + 1}</span>
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="20" 
              height="20" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="1.5" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              class="text-mistyk-400 group-hover:text-mistyk-600 transition-colors"
            >
              <path d={section.icon} />
            </svg>
          </div>
          
          <h2 class={`font-display text-2xl mb-2 text-mistyk-900 ${section.accent} inline-block pb-1`}>
            {section.title}
          </h2>
          
          <p class="text-mistyk-600 leading-relaxed">
            {section.subtitle}
          </p>
          
          <div class="mt-6 flex items-center text-sm text-mistyk-500 group-hover:text-mistyk-700 transition-colors">
            <span>Enter</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transform group-hover:translate-x-1 transition-transform">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Activity Strip // The living pulse -->
  <section class="border-t border-mistyk-200 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h3 class="font-display text-xl text-mistyk-900">Recent Activity</h3>
        <span class="text-xs text-mistyk-500 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          Archive in motion
        </span>
      </div>
      
      <div class="space-y-4">
        <!-- These will be dynamic later -->
        <div class="flex items-center gap-4 p-4 border border-mistyk-200 bg-white/30">
          <span class="text-xs text-dispatch uppercase tracking-wider w-20">Dispatch</span>
          <span class="text-mistyk-900">Project 2025: The Conspiracy That Isn't a Theory</span>
          <span class="ml-auto text-xs text-mistyk-500">Dec 2025</span>
        </div>
        <div class="flex items-center gap-4 p-4 border border-mistyk-200 bg-white/30">
          <span class="text-xs text-archive uppercase tracking-wider w-20">Archive</span>
          <span class="text-mistyk-900">At One Time, The Temple Shook</span>
          <span class="ml-auto text-xs text-mistyk-500">2025</span>
        </div>
        <div class="flex items-center gap-4 p-4 border border-mistyk-200 bg-white/30">
          <span class="text-xs text-workbench uppercase tracking-wider w-20">Workbench</span>
          <span class="text-mistyk-900">Rebeldev v2.0 Site Integration</span>
          <span class="ml-auto text-xs text-mistyk-500">In Progress</span>
        </div>
      </div>
    </div>
  </section>

</Root>