---
import Root from '../layouts/Root.astro';

const musicLinks = [
  {
    label: 'BandLab',
    url: 'https://www.bandlab.com/m1styk',
    detail: 'Where tracks get built — beats, mixes, and works in progress.',
    icon: 'M9 18V5l12-2v13M9 18c0 1.657-2.015 3-4.5 3S0 19.657 0 18s2.015-3 4.5-3 4.5 1.343 4.5 3zm12-2c0 1.657-2.015 3-4.5 3S12 17.657 12 16s2.015-3 4.5-3 4.5 1.343 4.5 3z',
  },
  {
    label: 'SoundCloud',
    url: 'https://soundcloud.com/m1styk',
    detail: 'Finished releases and one-off drops, streamable anywhere.',
    icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3',
  },
  {
    label: 'Spotify',
    url: 'https://open.spotify.com/artist/m1styk',
    detail: 'Catch the catalog wherever you already listen.',
    icon: 'M8 11.5c2.5-1 6.5-1 9 .5m-10-3.5c3-1.5 8-1.5 11.5.5m-12.5-4c3.5-2 10-2 14 .5',
  },
];

const devLinks = [
  {
    label: 'GitHub',
    url: 'https://github.com/M1ztick',
    detail: 'Everything I ship, in the open — the full history of the work.',
    icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22',
  },
  {
    label: 'Insertabot',
    url: 'https://insertabot.io',
    detail: 'Live SaaS: an embeddable AI chatbot widget with RAG, billing, and analytics — built solo on Cloudflare\'s edge.',
    icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  },
  {
    label: 'SAIGE',
    url: 'https://github.com/M1ztick/SAIGE',
    detail: 'An AI alignment framework scoring ethical reasoning through five Buddhist principles instead of hardcoded rules.',
    icon: 'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm0-14a6 6 0 1 0 6 6 6 6 0 0 0-6-6z',
  },
];
---

<Root
  title="Links"
  description="Music, code, and everything Mistyk Media beyond the Dispatch."
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-xs font-mono text-teal/70 mb-2 uppercase tracking-widest">Beyond the Dispatch</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-6">
        Links
      </h1>
      <p class="text-lg text-mist/60 max-w-2xl mx-auto leading-relaxed">
        Mistyk Media is mainly a home for investigative writing — but there's more underneath it.
        I make music. I build software. Both come from the same place the Dispatch does: a need
        to make something honest out of the noise.
      </p>
    </header>

    <!-- Music Section -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded-lg bg-teal/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal">
            <path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
          </svg>
        </div>
        <h2 class="font-display text-2xl font-semibold text-mist">Music</h2>
      </div>
      <p class="text-mist/50 leading-relaxed mb-8 max-w-2xl">
        I write and record as <strong class="text-mist/70">Mistyk</strong> — hip-hop and punk rock
        crossovers, genre-blending experiments, and tracks that carry the same political and
        spiritual undercurrent as the Dispatch, just set to a beat instead of a byline.
      </p>

      <div class="grid sm:grid-cols-3 gap-4">
        {musicLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group crossroads-card p-5 hover:border-teal/50 flex flex-col gap-3"
          >
            <div class="flex items-center justify-between">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-teal/70 group-hover:text-teal transition-colors">
                <path d={link.icon} />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mist/20 group-hover:text-teal group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </div>
            <div>
              <h3 class="font-display text-mist group-hover:text-teal transition-colors mb-1">{link.label}</h3>
              <p class="text-xs text-mist/40 leading-relaxed">{link.detail}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Development Section -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded-lg bg-coral/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-coral">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </div>
        <h2 class="font-display text-2xl font-semibold text-mist">Development</h2>
      </div>
      <p class="text-mist/50 leading-relaxed mb-8 max-w-2xl">
        Outside of writing and music, I build. Mostly AI infrastructure and ethics tooling —
        production systems running solo on Cloudflare's edge, plus research into what it would
        actually take to make AI behave with something like wisdom.
      </p>

      <div class="grid sm:grid-cols-3 gap-4">
        {devLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group crossroads-card p-5 hover:border-coral/30 flex flex-col gap-3"
          >
            <div class="flex items-center justify-between">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral/70 group-hover:text-coral transition-colors">
                <path d={link.icon} />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mist/20 group-hover:text-coral group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </div>
            <div>
              <h3 class="font-display text-mist group-hover:text-coral transition-colors mb-1">{link.label}</h3>
              <p class="text-xs text-mist/40 leading-relaxed">{link.detail}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Back to Dispatch CTA -->
    <div class="p-8 border border-dispatch/20 bg-dispatch/5 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-radial from-dispatch/5 to-transparent pointer-events-none"></div>
      <p class="text-mist/60 mb-4 relative z-10">Here for the writing?</p>
      <a
        href="/dispatch"
        class="relative z-10 inline-flex items-center gap-2 px-5 py-2.5 bg-dispatch text-void font-medium text-sm rounded-md hover:bg-dispatch/90 transition-colors"
      >
        Read The Dispatch
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</Root>
