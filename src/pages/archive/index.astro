---
import Root from '../../layouts/Root.astro';

// Placeholder releases
const releases = [
  {
    title: "At One Time, The Temple Shook",
    year: "2025",
    description: "A sonic meditation on disruption and transformation.",
    genre: ["Experimental", "Electronic"],
  },
  {
    title: "Heaven Sick",
    year: "2024",
    description: "Original music exploring the tension between aspiration and grounded reality.",
    genre: ["Electronic", "Ambient"],
  }
];
---

<Root 
  title="The Archive" 
  description="Original music, sound experiments, and sonic documentation."
  section="archive"
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Section Header -->
    <header class="mb-16">
      <p class="text-xs font-mono text-archive/60 mb-2">SECTION_02</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-mist mb-4">
        The Archive
      </h1>
      <p class="text-lg text-mist/60 max-w-2xl">
        Original frequencies from the edge. A living collection of sonic experiments and genre-blending innovation.
      </p>
    </header>

    <!-- Releases Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {releases.map((release) => (
        <div class="crossroads-card p-6 group">
          <!-- Cover placeholder with wave visualization hint -->
          <div class="aspect-square bg-void-100 mb-4 flex items-center justify-center border border-void-50/10">
            <div class="flex items-center gap-1">
              {[...Array(8)].map((_, i) => (
                <div class="w-1 bg-archive/40 rounded-full" style={`height: ${20 + Math.random() * 40}px`}></div>
              ))}
            </div>
          </div>
          
          <div class="flex items-baseline gap-3 mb-2">
            <span class="text-xs font-mono text-mist/40">{release.year}</span>
            <div class="flex gap-2">
              {release.genre.map(g => (
                <span class="text-xs text-archive/80">{g}</span>
              ))}
            </div>
          </div>
          
          <h2 class="font-display text-xl text-mist mb-2">
            {release.title}
          </h2>
          <p class="text-sm text-mist/50 mb-4">
            {release.description}
          </p>
          
          <div class="flex items-center gap-4">
            <button class="text-sm px-4 py-2 bg-archive/20 text-archive border border-archive/30 hover:bg-archive/30 transition-colors">
              ▶ Play
            </button>
            <button class="text-sm text-mist/40 hover:text-archive transition-colors">
              Download
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Player placeholder - dark themed -->
    <div class="mt-16 p-8 border border-void-50/10 bg-void-50/5 text-center">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="w-64 h-2 bg-void-100 rounded-full overflow-hidden">
          <div class="w-1/3 h-full bg-gradient-to-r from-coral to-teal"></div>
        </div>
      </div>
      <p class="text-sm text-mist/30 font-mono">
        FULL_ARCHIVE_PLAYER // COMING_SOON
      </p>
    </div>
  </div>
</Root>