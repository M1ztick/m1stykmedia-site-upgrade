---
interface Props {
  years: string[];
  byYear: Record<string, { id: string; data: { title: string; pubDate: Date } }[]>;
}

const { years, byYear } = Astro.props;
---

<nav aria-label="Dispatch archive">
  <ul class="space-y-6">
    {years.map(year => (
      <li>
        <h4 class="text-xs font-mono text-mist/40 mb-2 sticky top-0 bg-void-100/95 py-1 z-10">{year}</h4>
        <ul class="space-y-2">
          {byYear[year].map(entry => (
            <li>
              <a 
                href={`/dispatch/${entry.id}`} 
                class="group flex items-start gap-2 text-sm text-mist/70 hover:text-dispatch transition-colors"
              >
                <span class="mt-1.5 w-1 h-1 rounded-full bg-coral/40 group-hover:bg-dispatch shrink-0"></span>
                <span class="line-clamp-2">{entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</nav>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
